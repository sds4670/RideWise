# Copy this file to .env and fill in real values. Never commit .env.
LLM_BASE_URL=https://your-endpoint.example.com/openai/v1/
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-oss-120b
# Tool-calling mode: "native" (endpoint supports function calling) or "json"
# (JSON-action fallback). Run `python -m scripts.smoke_llm` to check which.
LLM_TOOL_MODE=native
# Set to 1 to show the error type/message in the UI "How I got this" expander.
DEBUG_ERRORS=0
# Optional: name of an embedding deployment on the endpoint. If set, the policy
# index adds embeddings (hybrid search); if unset, retrieval is BM25-only.
LLM_EMBED_MODEL=
